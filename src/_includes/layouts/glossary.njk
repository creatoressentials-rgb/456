---
layout: layouts/base.njk
---
<section class="page-hero">
  <div class="container">
    <span class="eyebrow" style="color:var(--red)">YouTube Glossary</span>
    <h1>{{ title }}</h1>
    {% if description %}<p>{{ description }}</p>{% endif %}
  </div>
</section>

<section style="padding-block: clamp(3rem, 6vw, 5rem);">
  <div class="container">
    <div class="article-body">
      {{ content | safe }}
      {% if related_terms and related_terms.length %}
      <div style="margin-top:2.5rem; padding-top:2rem; border-top:1px solid var(--border);">
        <h3 style="margin-bottom:1rem;">Related Terms</h3>
        <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
          {% for term in related_terms %}
          <a href="/glossary/{{ term }}/" class="post-tag" style="text-decoration:none; color:var(--charcoal); padding:0.375rem 0.875rem;">{{ term | replace("-", " ") | title }}</a>
          {% endfor %}
        </div>
      </div>
      {% endif %}
    </div>
    <div style="margin-top:3rem; padding-top:2rem; border-top:1px solid var(--border);">
      <p style="font-size:0.875rem; color:var(--slate); margin-bottom:1rem;">Want a clear growth plan for your YouTube channel?</p>
      <a href="/services/youtube-channel-audit/" class="btn btn-primary">Get a Channel Audit</a>
      &nbsp;
      <a href="/blog/" class="btn btn-secondary" style="margin-left:0.5rem;">Read the Blog</a>
    </div>
  </div>
</section>

<section class="bg-cloud" style="padding-block:clamp(2rem,4vw,3rem);">
  <div class="container">
    <p style="font-size:0.875rem; color:var(--slate); margin-bottom:1rem;">Browse all glossary terms</p>
    <a href="/glossary/" class="card-cta">
      Back to Glossary
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</section>
