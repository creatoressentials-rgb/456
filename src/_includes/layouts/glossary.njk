---
layout: layouts/base.njk
---
<section class="page-hero">
  <div class="container">
    <span class="eyebrow" style="color:var(--red)">YouTube Glossary</span>
    <h1>{{ title }}</h1>
    {% if description %}<p>{{ description }}</p>{% endif %}
  </div>
</section>

<section style="padding-block: clamp(3rem, 6vw, 5rem);">
  <div class="container">
    <div class="article-layout">

      <!-- Main content -->
      <div class="article-main">
        <div class="article-body">
          {{ content | safe }}
        </div>
        <div style="margin-top:3rem; padding-top:2rem; border-top:1px solid var(--border);">
          <p style="font-size:0.875rem; color:var(--slate); margin-bottom:1rem;">Browse all glossary terms</p>
          <a href="/glossary/" class="btn btn-secondary">Back to Glossary</a>
          &nbsp;
          <a href="/blog/" class="btn btn-secondary" style="margin-left:0.5rem;">Read the Blog</a>
        </div>
      </div>

      <!-- Sticky sidebar -->
      <aside class="article-sidebar">

        <!-- Tax CTA -->
        <div class="sidebar-cta">
          <span class="eyebrow">Creator Finances</span>
          <h3>Taxes done right for YouTubers</h3>
          <p>Every income stream, every deduction — handled by someone who gets YouTube.</p>
          <a href="/services/tax-services-for-youtubers/" class="btn btn-primary">Tax Services</a>
          <a href="/services/bookkeeping-for-youtubers/" class="btn btn-outline-white">Bookkeeping</a>
        </div>

        <!-- Related terms -->
        {% if related_terms and related_terms.length %}
        <div class="sidebar-related">
          <h4>Related Terms</h4>
          <ul class="sidebar-related-list">
            {% for term in related_terms %}
            <li>
              <a href="/glossary/{{ term }}/">{{ term | termName }}</a>
            </li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}

        <!-- Other glossary terms -->
        {% if collections.glossary.length %}
        <div class="sidebar-related">
          <h4>Explore Glossary</h4>
          <ul class="sidebar-related-list">
            {% for term in collections.glossary | limit(6) %}
            {% if term.url !== page.url %}
            <li>
              <a href="{{ term.url }}">{{ term.data.title }}</a>
            </li>
            {% endif %}
            {% endfor %}
          </ul>
          <a href="/glossary/" style="display:inline-block; margin-top:1rem; font-size:0.8rem; font-weight:700; font-family:var(--font-head); text-transform:uppercase; letter-spacing:0.08em; color:var(--red);">Full Glossary &rarr;</a>
        </div>
        {% endif %}

        <!-- Tools teaser -->
        <div class="sidebar-tools">
          <p>The tools every serious YouTuber needs in their stack.</p>
          <a href="/tools/" class="btn btn-secondary">Browse Tools</a>
        </div>

      </aside>
    </div>
  </div>
</section>
