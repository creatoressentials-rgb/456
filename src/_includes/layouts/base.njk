<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% if title %}{{ title }} | Creator Essentials{% else %}Creator Essentials — YouTube Growth Without the Guesswork{% endif %}</title>
  <meta name="description" content="{{ description or 'Creator Essentials — tools, tips, and resources to help YouTubers grow their channel and manage their finances.' }}" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://www.creatoressentials.com{{ page.url }}" />
  {% if featured_image %}<meta property="og:image" content="{{ featured_image }}" />{% endif %}
  <link rel="stylesheet" href="/assets/css/main.css" />
  <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml" />
  <meta property="og:title" content="{{ title or 'Creator Essentials' }}" />
  <meta property="og:description" content="{{ description or 'YouTube growth without the guesswork.' }}" />
  <meta property="og:type" content="website" />
</head>
<body>

  <nav class="site-nav" aria-label="Main navigation">
    <div class="container nav-inner">

      <a href="/" class="nav-logo" aria-label="Creator Essentials home">
        <img src="/assets/images/logo.png" alt="Creator Essentials" class="nav-logo-img" style="height:28px;width:auto;" />
      </a>

      <button class="nav-toggle" aria-expanded="false" aria-label="Toggle navigation">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
          <path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>

      <ul class="nav-links" role="list">

        <li class="has-dropdown">
          <a href="/services/">Services</a>
          <ul class="dropdown" role="menu">
            <li><a href="/services/tax-services-for-youtubers/" role="menuitem">Tax Services</a></li>
            <li><a href="/services/bookkeeping-for-youtubers/" role="menuitem">Bookkeeping</a></li>
          </ul>
        </li>

        <li class="has-dropdown">
          <a href="/resources/">Resources</a>
          <ul class="dropdown" role="menu">
            <li><a href="/blog/" role="menuitem">Blog</a></li>
            <li><a href="/glossary/" role="menuitem">YouTube Terms Glossary</a></li>
            <li><a href="/resources/free-guides/" role="menuitem">Free Creator Guides</a></li>
            <li><a href="/resources/facebook-groups/" role="menuitem">Facebook Groups</a></li>
            <li><a href="/tools/" role="menuitem">YouTuber Tools</a></li>
          </ul>
        </li>

        <li><a href="/about/">About</a></li>
        <li><a href="/contact/" class="btn btn-primary" style="font-size:0.875rem; padding:0.5rem 1.1rem; color:#fff;">Contact</a></li>
      </ul>

    </div>
  </nav>

  {% include "breadcrumbs.njk" %}

  <main id="main-content">
    {{ content | safe }}
  </main>

  <footer class="site-footer" aria-label="Site footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" aria-label="Creator Essentials home">
            <img src="/assets/images/logo.png" alt="Creator Essentials" class="footer-logo-img" style="height:40px;width:auto;" />
          </a>
          <p>Tools, tips, and resources for serious YouTubers.</p>
        </div>
        <div class="footer-col">
          <h4>Tax &amp; Finance</h4>
          <ul class="footer-links">
            <li><a href="/services/tax-services-for-youtubers/">Tax Services</a></li>
            <li><a href="/services/bookkeeping-for-youtubers/">Bookkeeping</a></li>
            <li><span style="color:var(--slate);">Financial Planning <em>(coming soon)</em></span></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Free Resources</h4>
          <ul class="footer-links">
            <li><a href="/tools/">YouTuber Tools</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li><a href="/glossary/">YouTube Terms Glossary</a></li>
            <li><a href="/resources/free-guides/">Free Creator Guides</a></li>
            <li><a href="/about/">About</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </div>
      </div>
